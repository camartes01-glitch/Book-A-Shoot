{
  "expo": {
    "name": "BOOK A SHOOT",
    "slug": "book-a-shoot",
    "owner": "keerthika2712",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "camartescustomer",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.camartes.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Camartes uses your location to find your event address and match nearby photographers and videographers."
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFF7ED"
    },
    "android": {
      "package": "com.camartes.customer",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/applogo.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/book-a-shoot-splash-ios.png",
          "backgroundColor": "#FFF7ED",
          "resizeMode": "contain",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/book-a-shoot-splash-android.png",
            "backgroundColor": "#FFF7ED",
            "resizeMode": "contain",
            "imageWidth": 288
          },
          "ios": {
            "image": "./assets/images/book-a-shoot-splash-ios.png",
            "backgroundColor": "#FFF7ED",
            "resizeMode": "contain",
            "imageWidth": 280
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Camartes uses your location to find your event address and match nearby photographers and videographers."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba406cb5-97a7-48e8-ba5e-21571c5d9f83"
      }
    }
  }
}
