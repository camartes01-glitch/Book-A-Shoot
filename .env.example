# ==============================================================================
# BOOK A SHOOT (Camartes Customer App) — Environment Variables
# ==============================================================================
# Copy this file to `.env` in the repository root for local development.
# NOTE: Never commit `.env` or any real API keys/client secrets to Git.

# ------------------------------------------------------------------------------
# 1. Development Authentication Mode
# ------------------------------------------------------------------------------
# Controls whether development uses local demo credentials or the real Camartes auth API.
# Source of truth fallback is AUTH_MODE in `src/config/authMode.ts` (defaults to DEMO).
# Allowed values:
#   DEMO  — local demo accounts (demo@bookashoot.com / Demo@12345), no live auth calls
#   REAL  — authenticates against the live Camartes backend API
# NOTE: Production/release builds always force REAL regardless of this variable.
EXPO_PUBLIC_AUTH_MODE=DEMO

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Client IDs (Optional for Development)
# ------------------------------------------------------------------------------
# Public Google OAuth client IDs for "Continue with Google".
# DO NOT put Google client secrets here (Expo public variables are visible in bundles).
# Leave blank during local development unless genuine OAuth clients are configured.
# Google Cloud Console Setup:
#   - Web Client: Authorized origin/redirect URI matches your local port (e.g. http://localhost:43158)
#   - Android Client: Package name `com.camartes.customer` + signing SHA-1
#   - iOS Client: Bundle identifier `com.camartes.customer`
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID

# ------------------------------------------------------------------------------
# 3. Google Places API Key (Optional)
# ------------------------------------------------------------------------------
# Enables Google Places address autocomplete REST API on the event location screen.
# Leave blank to use the built-in curated Indian cities fallback (booking flow works end-to-end).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# ------------------------------------------------------------------------------
# 4. Backend Platform API URL (Reference)
# ------------------------------------------------------------------------------
# The live Camartes Vendor Platform URL is set in source code:
# https://camartes-backend.onrender.com
# (Referenced in src/services/camartesClient.ts and src/services/vendorApi.ts)
